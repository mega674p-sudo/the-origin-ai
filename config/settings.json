{
  "agent_name": "GIGA PHONE AI",
  "environment": "ubuntu-worker-with-telegram-control",
  "worker_mode": "hybrid",
  "ai_provider": "gemini",
  "gemini": {
    "api_key": "YOUR_GEMINI_API_KEY_HERE",
    "model": "gemini-3.5-flash"
  },
  "telegram": {
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN_HERE",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID_HERE",
    "allowed_user_id": "YOUR_ALLOWED_USER_ID_HERE"
  },
  "execution": {
    "max_retries": 3,
    "timeout": 30,
    "max_output": 8000,
    "workspace": ".",
    "shell": "auto"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/execution.log"
  }
}
